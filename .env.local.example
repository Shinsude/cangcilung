# cangcilung — Environment Variables (Vercel: Settings → Environment Variables)
# Salin file ini menjadi pengaturan di Vercel. Semua opsional; tanpa ini aplikasi
# tetap berjalan 100% lokal.

# --- Sinkronisasi cloud + RAG (Supabase) ---
# Dari dashboard Supabase: Settings → API → Project URL (SUPABASE_URL) & anon key.
# Wajib menjalankan supabase/schema.sql + mengaktifkan Anonymous sign-ins dulu.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Proxy chat server-side (aman: key tidak pernah masuk browser) ---
# API key untuk /api/chat. Bila diisi, pengguna bisa set Base URL = /api tanpa key.
GROQ_API_KEY=
# Atau key lain (OpenRouter, dll) — dipakai bila GROQ_API_KEY kosong.
PROXY_API_KEY=
# Base URL upstream (default Groq). Contoh OpenRouter: https://openrouter.ai/api/v1
PROXY_BASE_URL=https://api.groq.com/openai/v1
# Model default untuk proxy (tidak wajib; setiap request boleh memilih model sendiri).
PROXY_MODEL=openai/gpt-oss-120b
# Bila proxy dipakai dari origin selain ini, tambahkan daftar origin yang diizinkan.
# ALLOWED_ORIGIN=https://cangcilung.vercel.app